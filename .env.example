# AI API Configuration
# OpenAI API Key - Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key - Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# AI Model Settings
AI_MODEL=gpt-4
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000

# Automation Settings
AUTOMATION_DELAY=0.5
AUTOMATION_TIMEOUT=30
FAILSAFE_ENABLED=true

# Screenshot and Vision Settings
SCREENSHOT_DIR=./screenshots
SCREENSHOT_FORMAT=png
VISION_CONFIDENCE_THRESHOLD=0.8

# GUI Automation
GUI_CLICK_DELAY=0.1
GUI_TYPE_DELAY=0.05

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/automation.log
LOG_FORMAT=json

# Security
SAFE_MODE=true
REQUIRE_CONFIRMATION=false

# Performance
MAX_WORKERS=4
CACHE_ENABLED=true
CACHE_TTL=3600

# Platform Specific (uncomment as needed)
# Windows
# WINDOWS_ADMIN_MODE=false

# macOS
# MACOS_ACCESSIBILITY_ENABLED=true

# Linux
# LINUX_DISPLAY=:0
